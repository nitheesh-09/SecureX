# --- Temporary Storage & Uploaded Files (CRITICAL FOR PRIVACY) ---
# Prevent test and uploaded user files from leaking into Git
storage/
temp/
temp_storage/
tmp/
uploads/
sanitized/
*.tmp
*.temp

