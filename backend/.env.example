# SecureX Backend Environment Configuration Example
# Copy this file to .env for local overrides (do NOT commit .env with real secrets)

# Server Configuration
PORT=8000
DEBUG=True

# AI Provider Selection: 'mock' | 'anthropic' | 'openai'
# Default: mock (works fully offline without any API keys)
AI_PROVIDER=mock

# Optional API Keys (Only needed if AI_PROVIDER is set to anthropic or openai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ephemeral File Storage
TEMP_STORAGE_DIR=./temp_storage
FILE_TTL_MINUTES=15
